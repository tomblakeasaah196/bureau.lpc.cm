# =============================================================================
# Bureau LPC ERP  --  Environment Configuration (template)
# =============================================================================
# Copy this file to .env and fill in the real values. Commit THIS file, NOT .env.
# =============================================================================


# --- APPLICATION -------------------------------------------------------------

APP_ENV=production
APP_NAME="LPC ERP - Distribution Agroalimentaire"
APP_URL=https://bureau.lpc.cm
APP_DEFAULT_LANG=fr
APP_DEBUG=false


# --- DATABASE ----------------------------------------------------------------

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4


# --- SESSION -----------------------------------------------------------------

SESSION_LIFETIME_MINUTES=480
SESSION_COOKIE_NAME=lpc_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax


# --- SECURITY ----------------------------------------------------------------

BCRYPT_COST=12
CSRF_TOKEN_LENGTH=32
TRUSTED_PROXIES=


# --- FILE UPLOADS ------------------------------------------------------------

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_PATH=/absolute/path/to/uploads


# --- ERROR HANDLING & LOGGING -----------------------------------------------

LOG_ERRORS=true
DISPLAY_ERRORS=false
ERROR_LOG_PATH=/absolute/path/outside/public_html/lpc_error.log


# --- RATE LIMITING -----------------------------------------------------------

AUTH_MAX_ATTEMPTS_PER_15MIN=10
RECOVERY_MAX_ATTEMPTS_PER_HOUR=3


# --- MAIL (password reset delivery) -----------------------------------------

MAIL_FROM=no-reply@bureau.lpc.cm
MAIL_FROM_NAME="Bureau LPC"
MAIL_REPLY_TO=support@bureau.lpc.cm


# --- FLEET ODOMETER RULES ---------------------------------------------------

FLEET_ODOMETER_JUMP_WARN=800
FLEET_ODOMETER_JUMP_MAX=3000


# --- SIGNER OTP (Sprint 7C) --------------------------------------------------
# Kill switch. Leave 'true' in production.
SIGNER_OTP_ENABLE=true
# Optional: alternate inbox for the fallback e-mail. Defaults to MAIL_FROM.
SIGNER_OTP_MAIL_TO=
# SMS provider — 'twilio' or empty (empty → mail/log fallback only).
SMS_PROVIDER=
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=
