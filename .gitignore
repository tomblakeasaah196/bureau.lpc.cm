# =============================================================================
# Bureau LPC ERP — .gitignore
# =============================================================================

# Secrets
.env
.env.*
!.env.example
# Certificates, private keys, and credential exports
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials*.json
secrets*.json

# Historical / archive
docs/archive/
error_log
*.log
*.sql
!migrations/*.sql
!scripts/tests/*.sql

# Backups
*.bak
*.tar.gz
*.zip
*.dump
*.sqlite
*.sqlite3
*.db

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build artifacts / packages — root folders only
/node_modules/
/vendor/

# Uploaded runtime files (structure kept via .gitkeep, contents excluded)
uploads/*/*/*
!uploads/*/*/.gitkeep
!uploads/.htaccess

# The BUILT Tailwind CSS is committed on purpose so the deploy zip doesn't
# require node/npm on the server. Only ignore intermediate build files.
